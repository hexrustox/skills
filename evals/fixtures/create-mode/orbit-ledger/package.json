{
  "name": "orbit-ledger",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --if-present test:watch",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed-dev.mjs",
    "codegen": "pnpm --filter @orbit/api codegen"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "5.7.3"
  }
}
